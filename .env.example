# Copie este arquivo para ".env" e preencha com os dados do SEU ambiente.
# O arquivo .env real NÃO vai para o Git (veja o .gitignore).

# Banco de dados (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pixelstore
DB_USER=root
DB_PASS=

# Aplicação
APP_NAME=PixelStore
# true mostra detalhes de erro na tela (use apenas em desenvolvimento)
APP_DEBUG=false
# Opcional: caminho base da aplicação, ex.: /pixelstore
# Deixe vazio para detectar automaticamente.
APP_BASE_URL=
