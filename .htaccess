# Impede listagem de diretórios
Options -Indexes

# Bloqueia acesso direto a arquivos sensíveis (.env, .sql, .md, .gitignore...)
<FilesMatch "^\.env|\.(sql|md|example|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
